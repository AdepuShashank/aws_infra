#!/usr/bin/env bash
# ---------------------------------------------------------------------------
# Platform bootstrap: Calico, then Argo CD, then the root Application.
# ---------------------------------------------------------------------------
# Runs on the control plane over SSM Run Command, which is why Terraform never
# needs the kubernetes or helm providers. The API server is private, so there is
# no path from a CI runner into the cluster; the only bridge is an SSM command
# executed on a node that is already inside the VPC.
#
# Every step is idempotent. The script is re-run by hand often enough that
# "create, and if it exists, replace" is the only sane default, and re-running it
# must converge rather than error out.
#
# Ordering matters and is not arbitrary:
#   1. Calico first. Without a CNI the nodes stay NotReady and no other pod can
#      be scheduled, so nothing installed later would actually run.
#   2. Argo CD next, and only once the nodes are Ready - its pods need scheduling.
#   3. The root Application last, because it points at a directory that Phase 7
#      fills in; creating it before then would sync an empty tree and report
#      itself OutOfSync for no useful reason.

set -euo pipefail

REGION="${region}"
STATE_SSM="${state_ssm}"
ARGOCD_PASSWORD_SSM="${argocd_password_ssm}"
ARGOCD_REPO_KEY_SSM="${argocd_repo_key_ssm}"
CALICO_VERSION="${calico_version}"
HELM_VERSION="${helm_version}"
HELM_SHA256="${helm_sha256}"
ARGOCD_CHART_VERSION="${argocd_chart_version}"
CLUSTER_NAME="${cluster_name}"
GITHUB_SSH_HOST="${gitops_ssh_host}"
GITOPS_REPO_URL="${gitops_repo_url}"
GITOPS_REPO_PATH="${gitops_repo_path}"
GITOPS_TARGET_REVISION="${gitops_target_revision}"
POD_CIDR="${pod_cidr}"

export KUBECONFIG=/etc/kubernetes/admin.conf

publish_state() {
  aws ssm put-parameter --name "$STATE_SSM" --value "$1" --type String \
    --overwrite --region "$REGION" >/dev/null 2>&1 || true
  echo "[platform-bootstrap] state: $1"
}

# Names the failing command, not just a line number. A line number alone is close
# to useless here: with `set -e` plus a heredoc pipeline, $LINENO routinely points
# at the nearest comment rather than at the command that failed, which is how a
# failure in the CRD install reported "failed at line 91" where line 91 was a
# sentence in a comment.
trap 'publish_state "failed (exit $?): $BASH_COMMAND"' ERR

publish_state "starting"

# ---------------------------------------------------------------------------
# Wait for the API server
# ---------------------------------------------------------------------------
# The association can fire while the control plane is still finishing kubeadm init.
# Retrying the readiness loop is the difference between this script being safe to
# re-run and it racing the thing it depends on.
log() { echo "[platform-bootstrap] $*"; }

log "waiting for the API server"
for i in $(seq 1 60); do
  if kubectl get --raw /readyz >/dev/null 2>&1; then
    log "API server ready after $i attempt(s)"
    break
  fi
  if [ "$i" -eq 60 ]; then
    log "ERROR: API server not ready after 10 minutes"
    exit 1
  fi
  sleep 10
done

# ---------------------------------------------------------------------------
# Calico
# ---------------------------------------------------------------------------
# CRDs first, then the operator, then the Installation custom resource.
#
# The Installation resource is rendered here rather than fetched. Upstream's
# custom-resources.yaml ships an IP pool of 192.168.0.0/16, and the pod CIDR this
# cluster was initialised with is $POD_CIDR. Applying the stock manifest
# unchanged produces a cluster whose kubelet asks for addresses from a block the
# API server never allocated from, which shows up as every pod stuck in ContainerCreating
# and an IP pool that no node is using.
#
# kubectl create, not apply, for the CRDs: the bundle is ~3 MB and apply exceeds
# the API server's request limit.
#
# The existence check is a check, not a fallback. An earlier version did
# `create || replace --force`, and on any re-run the create failed with
# AlreadyExists and the replace then tried to delete and recreate 3 MB of CRDs
# that tigera-operator was actively serving - which fails, and takes the whole
# script down with it. A CRD that already exists is the outcome this section
# wanted, so there is nothing to do.
# The check is for the tigera-operator DEPLOYMENT, not for the CRDs.
#
# The CRDs and the operator are installed by separate files, and either can be
# present without the other: a partially failed run leaves 30 CRDs and no
# operator. Testing for the CRD instead makes that state look complete and skips
# installing the one thing that is actually missing - which is the state this
# cluster was in when the CRDs had been force-replaced.
if kubectl -n tigera-operator get deployment tigera-operator >/dev/null 2>&1; then
  log "tigera-operator already running, skipping CNI install"
else
  log "installing Calico CRDs ($CALICO_VERSION)"
  MANIFESTS="https://raw.githubusercontent.com/projectcalico/calico/$CALICO_VERSION/manifests"

  # Tolerated, not forced. The bundle is ~3 MB and may already be partly present;
  # kubectl create exits non-zero for any single AlreadyExists, and under `set -e`
  # that aborted the run with every CRD already created. Nothing here may delete:
  # see docs/adr/0004-calico-crd-replace.md for what `replace --force` did to this
  # cluster. The wait below is the real completion signal, not the exit code.
  kubectl create -f "$MANIFESTS/v1_crd_projectcalico_org.yaml" >/dev/null 2>&1 || true

  log "waiting for the Calico CRDs to be established"
  CRD_WAIT=0
  for i in $(seq 1 60); do
    if kubectl get crd installations.operator.tigera.io >/dev/null 2>&1 &&
      kubectl get crd ippools.crd.projectcalico.org >/dev/null 2>&1; then
      CRD_WAIT=1
      break
    fi
    sleep 5
  done
  if [ "$CRD_WAIT" != "1" ]; then
    echo "ERROR: Calico CRDs did not become established within 5 minutes" >&2
    exit 1
  fi

  log "installing the tigera operator"
  kubectl create -f "$MANIFESTS/tigera-operator.yaml" ||
    kubectl apply -f "$MANIFESTS/tigera-operator.yaml"

  kubectl -n tigera-operator rollout status deployment/tigera-operator --timeout=300s
fi

# The Installation resource is applied, not created: apply is the idempotent one,
# and this is the one object whose content must win over whatever is there. It is
# also the source of the pod CIDR, which must match what kubeadm was given.
#
# Waited on explicitly before going further. The IPPool is created by the operator
# reconciling this object, so "the CRDs exist" and "pods can get an IP" are
# different moments, and only the second one matters.
log "applying the Calico Installation with pod CIDR $POD_CIDR"
cat <<EOF | kubectl apply -f -
apiVersion: operator.tigera.io/v1
kind: Installation
metadata:
  name: default
spec:
  calicoNetwork:
    bgp: Disabled
    ipPools:
      - blockSize: 26
        cidr: $POD_CIDR
        encapsulation: VXLAN
        natOutgoing: Enabled
        nodeSelector: all()
EOF

log "waiting for the Calico IP pool to be created"
POOL_WAIT=0
for i in $(seq 1 60); do
  if kubectl get ippool default-ipv4-ippool -o jsonpath='{.spec.cidr}' 2>/dev/null | grep -q "$POD_CIDR"; then
    POOL_WAIT=1
    break
  fi
  sleep 5
done
if [ "$POOL_WAIT" != "1" ]; then
  echo "ERROR: Calico did not create an IPPool for $POD_CIDR within 5 minutes." >&2
  echo "Check that the tigera-operator is Running and can write operator CRs." >&2
  exit 1
fi
log "IP pool ready"

log "waiting for the Calico daemonset to roll out"
for i in $(seq 1 90); do
  DS_READY="$(kubectl -n calico-system get daemonset calico-node -o jsonpath='{.status.numberReady}' 2>/dev/null || echo 0)"
  DS_DESIRED="$(kubectl -n calico-system get daemonset calico-node -o jsonpath='{.status.desiredNumberScheduled}' 2>/dev/null || echo 0)"
  if [ "$${DS_READY:-0}" -gt 0 ] && [ "$DS_READY" = "$DS_DESIRED" ]; then
    log "calico-node ready: $DS_READY/$DS_DESIRED"
    break
  fi
  if [ "$i" -eq 90 ]; then
    log "ERROR: calico-node did not become ready ($DS_READY/$DS_DESIRED)"
    exit 1
  fi
  sleep 10
done

publish_state "calico-installed"

# ---------------------------------------------------------------------------
# Helm
# ---------------------------------------------------------------------------
# Installed here rather than in cloud-init because Phase 6 is the first thing that
# needs it and Phase 4 has no reason to carry a ~50 MB download. The checksum is
# verified, so the download is pinned to this exact artifact rather than to a URL.
# Helm is installed once and then left alone. Re-downloading ~50 MB on every
# scheduled association run is pointless, and the download-then-extract path is the
# flakiest step in this script - one run failed at `tar -xzf` with a perfectly good
# tarball and 23 GB free, which is not a diagnosable failure.
#
# The version is compared rather than just testing -e, so bumping helm_version
# still installs the new one. `helm version --short` prints "v3.20.0+gb2e4314";
# the build metadata is stripped before comparing.
log "checking for helm $HELM_VERSION"
install_helm=false
if [ -x /usr/local/bin/helm ]; then
  INSTALLED_HELM="$(/usr/local/bin/helm version --short 2>/dev/null | sed 's/+.*//')"
  if [ "$INSTALLED_HELM" = "v$HELM_VERSION" ]; then
    log "helm $HELM_VERSION already installed, skipping"
  else
    log "helm $INSTALLED_HELM present, replacing with $HELM_VERSION"
    install_helm=true
  fi
else
  install_helm=true
fi

if [ "$install_helm" = "true" ]; then
  case "$(uname -m)" in
    aarch64 | arm64) HELM_ARCH=arm64 ;;
    x86_64) HELM_ARCH=amd64 ;;
    *)
      log "ERROR: unsupported architecture $(uname -m)"
      exit 1
      ;;
  esac

  HELM_TARBALL="helm-v$HELM_VERSION-linux-$HELM_ARCH.tar.gz"
  rm -rf "/tmp/$HELM_TARBALL" "/tmp/linux-$HELM_ARCH"

  curl -fsSL --retry 5 "https://get.helm.sh/$HELM_TARBALL" -o "/tmp/$HELM_TARBALL"

  # The published sha256sum file names the file it belongs to; the first field is
  # the digest, which is the only part compared here.
  REMOTE_SHA="$(curl -fsSL --retry 5 "https://get.helm.sh/$HELM_TARBALL.sha256sum" | awk '{print $1}')"
  echo "$REMOTE_SHA  /tmp/$HELM_TARBALL" | sha256sum -c - >/dev/null ||
    { log "ERROR: helm checksum mismatch (expected $HELM_SHA256)"; exit 1; }

  tar -xzf "/tmp/$HELM_TARBALL" -C /tmp ||
    { log "ERROR: could not extract $HELM_TARBALL"; exit 1; }
  install -m 0755 "/tmp/linux-$HELM_ARCH/helm" /usr/local/bin/helm
  rm -rf "/tmp/$HELM_TARBALL" "/tmp/linux-$HELM_ARCH"
fi

# helm's own state and cache belong on disk, not in $HOME, which is not predictable
# under systemd and may not be writable.
export HELM_CACHE_HOME=/var/cache/helm
export HELM_CONFIG_HOME=/var/lib/helm
export HELM_DATA_HOME=/var/lib/helm
mkdir -p "$HELM_CACHE_HOME" "$HELM_CONFIG_HOME" "$HELM_DATA_HOME"

# Clear a release stuck mid-upgrade.
#
# When a `helm upgrade` fails - here because `--wait` timed out on a repo-server
# that could not pass its probe - Helm leaves a release Secret with status
# pending-upgrade. Every subsequent upgrade then fails immediately with
# "another operation (install/upgrade/rollback) is in progress" and does no work
# at all, so one timed-out run permanently wedges every later run.
#
# Deleting only the *pending* Secret is deliberate. `helm rollback argocd 0`
# would also work but it uninstalls the release first, so a retry would have to
# recreate the CRDs too. The deployed release's Secret is left alone.
PENDING_SECRETS=0
PENDING_SECRETS="$(kubectl -n argocd get secret \
  -l owner=helm,name=argocd \
  -o jsonpath="{range .items[?(@.metadata.labels.status)]}{.metadata.labels.status}{'\n'}{end}" 2>/dev/null |
  grep -c '^pending' || true)"

if [ "$PENDING_SECRETS" != "0" ]; then
  log "clearing a stuck pending Argo CD release ($PENDING_SECRETS secret(s))"
  # By label, not by field selector. The Secret's *type* is helm.sh/release.v1
  # for every revision including pending ones - pending is a label, so a
  # field-selector on type=...pending-upgrade matches nothing and silently leaves
  # the wedge in place while appearing to do the job.
  kubectl -n argocd delete secret \
    -l owner=helm,name=argocd,status=pending-upgrade 2>/dev/null || true
  kubectl -n argocd delete secret \
    -l owner=helm,name=argocd,status=pending-install 2>/dev/null || true
  kubectl -n argocd delete secret \
    -l owner=helm,name=argocd,status=pending-rollback 2>/dev/null || true
fi

helm repo add argo https://argoproj.github.io/argo-helm --force-update >/dev/null 2>&1 || true
helm repo update >/dev/null 2>&1 || true

# ---------------------------------------------------------------------------
# Argo CD
# ---------------------------------------------------------------------------
# ClusterIP only. The spec's "not publicly exposed" is load-bearing: an Argo CD
# server reachable from the internet is an unauthenticated GitOps control plane
# with cluster-admin behind it, and the admin password lives in a Secret.
#
# No --wait. helm's --wait blocks on every deployment becoming Available, and the
# repo-server's probe as shipped by the chart cannot pass on this cluster (see
# below) - so waiting inside helm means never reaching the code that fixes it.
# The rollout waits are explicit and come after the probe is corrected.
log "installing Argo CD (chart $ARGOCD_CHART_VERSION)"
helm upgrade --install argocd argo/argo-cd \
  --version "$ARGOCD_CHART_VERSION" \
  --namespace argocd \
  --create-namespace \
  --set global.domain="argocd.internal.${cluster_name}.invalid" \
  --set server.service.type=ClusterIP \
  --set server.extraArgs."server.insecure"=false \
  --set controller.clusterAdminAccess.enabled=true \
  --set controller.repoServer.parallelismLimit=2 \
  --set controller.operation.processors.num=2 \
  --set controller.status.processors.num=2 \
  --set redis-ha.enabled=false \
  --set timeout.replication=60s \
  --timeout 10m

# The chart gives repo-server `GET /healthz?full=true` as BOTH its readiness and
# liveness probe, with `timeoutSeconds: 1`. The `full=true` variant is not a
# health check - it clones every configured repository and confirms the result.
#
# On a single-worker cluster where a cold git fetch takes more than a second, that
# is a liveness probe that measures the network rather than the process. Observed:
# 18 restarts of a container that was working, each one restarting the git fetch
# it had not finished. Making it a liveness probe that does no I/O is the fix; the
# expensive variant is what belongs on readiness, and even there it is left at the
# chart default below because a 10s timeout is enough for it on a warm cache.
log "correcting the repo-server probes"
kubectl -n argocd patch deployment argocd-repo-server --type=json -p='[
  {"op":"replace","path":"/spec/template/spec/containers/0/livenessProbe/httpGet/path","value":"/healthz"},
  {"op":"replace","path":"/spec/template/spec/containers/0/livenessProbe/timeoutSeconds","value":15},
  {"op":"replace","path":"/spec/template/spec/containers/0/readinessProbe/httpGet/path","value":"/healthz"},
  {"op":"replace","path":"/spec/template/spec/containers/0/readinessProbe/timeoutSeconds","value":15}
]' >/dev/null

for d in argocd-server argocd-repo-server argocd-redis; do
  kubectl -n argocd rollout status "deployment/$d" --timeout=600s
done
kubectl -n argocd rollout status statefulset/argocd-application-controller --timeout=600s

log "waiting for the Argo CD API to answer"
for i in $(seq 1 60); do
  if kubectl -n argocd exec statefulset/argocd-application-controller -- argocd-application-controller health --timeout 5s >/dev/null 2>&1; then
    break
  fi
  sleep 10
done

publish_state "argocd-installed"

# ---------------------------------------------------------------------------
# Admin password into SSM
# ---------------------------------------------------------------------------
# The initial admin password Secret only exists until the first admin changes the
# password. Reading it out of the Secret and storing it under the cluster's own
# parameter prefix is what makes `scripts/kubeconfig-via-ssm.sh` able to log in
# without anyone ever pasting a password into a terminal.
log "publishing the Argo CD admin password to $ARGOCD_PASSWORD_SSM"
ARGOCD_PASSWORD="$(kubectl -n argocd get secret argocd-initial-admin-secret -o jsonpath='{.data.password}' | base64 -d)"
kubectl -n argocd patch secret argocd-initial-admin-secret -p '{"stringData":{"password":"'"$ARGOCD_PASSWORD"'"}}' --type=merge >/dev/null

aws ssm put-parameter --name "$ARGOCD_PASSWORD_SSM" --value "$ARGOCD_PASSWORD" \
  --type SecureString --overwrite --region "$REGION"

# ---------------------------------------------------------------------------
# Repository credentials
# ---------------------------------------------------------------------------
# A private repo gets a deploy key from SSM registered as a repository Secret. A
# public repo needs none, and asking for one that does not exist would fail the
# step for no reason, so the presence of the parameter decides.
REPO_PRIVATE="$(aws ssm get-parameter --name "$ARGOCD_REPO_KEY_SSM" --query 'Parameter.Value' --output text 2>/dev/null || true)"

if [ -n "$REPO_PRIVATE" ] && [ "$REPO_PRIVATE" != "None" ]; then
  REPO_IS_PRIVATE=true
else
  REPO_IS_PRIVATE=false
  log "no deploy key at $ARGOCD_REPO_KEY_SSM: assuming the repository is public"
fi

if [ "$REPO_IS_PRIVATE" = "true" ]; then
  log "repository is private: registering a deploy key as a repository Secret"
  # The secret-type label is what makes argocd-repo-server pick this up. Without it
  # the secret exists, the Application references it, and every sync fails with a
  # bare "repository not found" - the label is the only thing that connects the two.
  kubectl -n argocd create secret generic repo-deploy-key \
    --from-literal=ssh-privatekey="$REPO_PRIVATE" \
    --dry-run=client -o yaml |
    kubectl label --local -f - argocd.argoproj.io/secret-type=repository -o yaml |
    kubectl apply -f -
fi

# ---------------------------------------------------------------------------
# Root Application (app of apps)
# ---------------------------------------------------------------------------
# Applied rather than created through the argocd CLI. The CLI path means waiting
# for the API to answer and authenticating with the admin password, which is two
# more things that can time out; applying the resource needs neither and is
# reviewable as plain YAML.
#
# repoURL switches to the ssh:// form when a deploy key exists, because that is
# what makes the repo-server reach for the secret above instead of trying the
# public https endpoint and failing on a private repo. GITHUB_SSH_HOST is supplied
# by the caller because the ssh:// form needs a host prefix that differs between
# github.com and a self-hosted Git server.
#
# The public branch is where the bug lived, and it is worth spelling out because the
# symptom points somewhere else entirely.
#
# gitops_repo_url arrives as bare `owner/repo` - no scheme, no host - and this used to
# assign that straight to repoURL on the public path. Argo CD then hands it to git as
# a repository location, git cannot work out what protocol or host it means, and the
# error comes back as:
#
#   Failed to load target state: failed to generate manifest for source 1 of 1:
#   rpc error: code = Unknown desc = failed to list refs: repository not found
#
# "repository not found" reads unambiguously like a permissions problem, and on this
# project it was believed to be one for a full day - the repository was ALSO private,
# so the two causes were indistinguishable from the outside. Making the repository
# public did not fix it, because the URL was still malformed. Diagnosing this needed
# `kubectl get application root -o jsonpath='{.spec.source.repoURL}'`, which is why it
# is worth printing the URL at the end rather than only the path.
#
# The https:// form is built here rather than taken from a variable because the host
# is part of what makes the URL valid, and gitops_ssh_host is the only host this module
# is told about.
if [ "$REPO_IS_PRIVATE" = "true" ]; then
  EFFECTIVE_REPO_URL="ssh://git@$${GITHUB_SSH_HOST}/$${GITOPS_REPO_URL}"
else
  EFFECTIVE_REPO_URL="https://$${GITHUB_SSH_HOST}/$${GITOPS_REPO_URL}"
fi

case "$EFFECTIVE_REPO_URL" in
  https://* | http://* | ssh://* | git://*)
    log "repository URL: $EFFECTIVE_REPO_URL"
    ;;
  *)
    log "ERROR: built a repository URL with no scheme: $EFFECTIVE_REPO_URL"
    log "       Argo CD will report this as 'repository not found', which looks like"
    log "       a permissions problem and is not one."
    exit 1
    ;;
esac

log "creating the root Application pointing at $EFFECTIVE_REPO_URL:$GITOPS_REPO_PATH"
# The exclude glob is load-bearing, and the reason is specific to this layout.
#
# The root app is a plain directory source with recurse: true, which walks every
# YAML under gitops/<env>. That includes projects/scaffold/, which is a HELM CHART:
# Chart.yaml plus values.yaml plus templates/*.yaml containing {{ .Release.Namespace }}
# and friends. Argo CD does not ignore Helm charts inside a directory source - it
# detects the Chart.yaml and renders it, using the root app's destination namespace
# (argocd) as .Release.Namespace. So without this exclude:
#
#   * the scaffold renders a Namespace object named "argocd", labelled
#     pod-security.kubernetes.io/enforce: restricted, which Pod Security Admission
#     then evaluates against Argo CD's own pods;
#   * the ResourceQuota, LimitRange, Role, RoleBinding and five NetworkPolicies land
#     in the argocd namespace, where the default-deny egress would cut Argo CD off
#     from the API server it is reconciling against.
#
# Excluding projects/** leaves the root app managing only apps/*.yaml, which is what
# it should manage: the Application definitions. The ApplicationSet in apps/ is the
# thing that points at projects/scaffold, and it sets its own destination namespace
# per project.
#
# apps/shared-postgres/** and apps/secret-store/** are excluded from the other
# direction. Their manifests are plain Kubernetes objects rather than Applications,
# so the root app would apply them into the argocd namespace while the Application
# that owns them applies them into data. Two owners for one object means self-heal
# fighting prune, and the loser is whichever one you were not looking at. Every
# directory under apps/ that holds real manifests needs its own entry here.
#
# The secret-store exclusion has a second, harder reason, spelled out at the top of
# gitops/<env>/apps/secret-store.yaml: a ClusterSecretStore is a CRD installed by
# another Application in this same directory, and Argo CD cannot generate manifests
# for the root app at all while that CRD is unregistered. Leaving it in scope fails
# the root sync, and the root sync is what creates everything else.
#
# The braces are required: Argo CD parses this as a comma-separated brace group, and
# a single unbraced pattern containing a slash behaves differently.
cat <<EOF | kubectl apply -f -
apiVersion: argoproj.io/v1alpha1
kind: Application
metadata:
  name: root
  namespace: argocd
  finalizers:
    - resources-finalizer.argocd.argoproj.io
spec:
  project: default
  source:
    repoURL: $EFFECTIVE_REPO_URL
    targetRevision: $GITOPS_TARGET_REVISION
    path: $GITOPS_REPO_PATH
    directory:
      recurse: true
      exclude: '{projects/**,apps/shared-postgres/**,apps/secret-store/**,*.md}'
  destination:
    server: https://kubernetes.default.svc
    namespace: argocd
  syncPolicy:
    automated:
      prune: true
      selfHeal: true
    syncOptions:
      - CreateNamespace=true
      - ServerSideApply=true
EOF

publish_state "platform-bootstrap-complete"

log "platform bootstrap finished"
log "  kubectl -n argocd get applications -w"
log "  admin password is in SSM: $ARGOCD_PASSWORD_SSM"
